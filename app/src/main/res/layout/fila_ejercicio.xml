<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:layout_marginBottom="8dp">

    <!-- Requisito: icono representativo según tipo -->
    <ImageView
        android:id="@+id/ivFilaIcono"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="16dp"
        android:src="@android:drawable/ic_menu_agenda" />

    <!-- Textos informativos de la fila -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvFilaNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre del ejercicio"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFilaDetalles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Repeticiones y tipo"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>