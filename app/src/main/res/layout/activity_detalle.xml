<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:padding="24dp">

    <!-- Requisito obligatorio: ImageView con sentido real -->
    <ImageView
        android:id="@+id/ivTipoEjercicio"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginBottom="24dp"
        android:src="@android:drawable/ic_menu_agenda" />

    <!-- Nombre del ejercicio que recibimos por Intent -->
    <TextView
        android:id="@+id/tvDetalleNombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nombre del Ejercicio"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <!-- Repeticiones que recibimos por Intent -->
    <TextView
        android:id="@+id/tvDetalleRepeticiones"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Repeticiones: 0"
        android:textSize="18sp"
        android:layout_marginBottom="8dp" />

    <!-- Tipo de ejercicio -->
    <TextView
        android:id="@+id/tvDetalleTipo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Categoría: -"
        android:textSize="16sp"
        android:layout_marginBottom="32dp" />

    <!-- Botón para cerrar y volver atrás con finish() -->
    <Button
        android:id="@+id/btnVolver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Volver" />

</LinearLayout>